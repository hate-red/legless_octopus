# Docker Compose environment overrides (optional).
# Copy to .env and change values if needed.

POSTGRES_DB=alfa_credit
POSTGRES_USER=alfa
POSTGRES_PASSWORD=alfa_secret
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=3000

# Used by the browser. Must be accessible from the host.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

JWT_SECRET=alfa-hackathon-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AI_ENABLED=true
AI_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
AI_SIMILARITY_THRESHOLD=0.5
APP_ENV=docker
