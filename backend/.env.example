# Backend
DATABASE_URL=postgresql+asyncpg://alfa:alfa_secret@localhost:5432/alfa_credit
JWT_SECRET=alfa-hackathon-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local AI (sentence-transformers)
AI_ENABLED=true
AI_MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
AI_SIMILARITY_THRESHOLD=0.5

# Internal mock endpoints (same backend in Docker)
MOCK_BASE_URL=http://127.0.0.1:8000
APP_ENV=development
