# Backend
DATABASE_URL=postgresql+asyncpg://alfa:alfa_secret@localhost:5432/alfa_credit
JWT_SECRET=alfa-hackathon-secret-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local GGUF model. In Docker it is baked into the image; for local runs
# the backend downloads it on first use unless it already exists.
AI_MODEL_REPO_ID=google/gemma-4-E4B-it-qat-q4_0-gguf
AI_MODEL_FILENAME=gemma-4-E4B_q4_0-it.gguf
AI_N_CTX=2048

APP_ENV=development
